# One shared login for you and whoever you trust — there are no separate
# accounts, and the app never needs to know which of you is in. Set both, or
# nothing opens. Use a long random password: this is the only thing standing
# between a stranger and your OpenRouter bill.
#
# Changing either value signs everyone out.
APP_USERNAME=
APP_PASSWORD=

# Get a key at https://openrouter.ai/keys, then copy this file to .env.local
# and paste it in. Without a key the app runs a deterministic simulated jury,
# so the UI is fully usable offline.
OPENROUTER_API_KEY=

# Optional — appears as the referring app on your OpenRouter dashboard.
OPENROUTER_SITE_URL=http://localhost:3000

# The archive of past cases. Leave CASES_BUCKET empty and nothing is stored —
# the court works exactly as before, it just doesn't remember.
#
# Create a PRIVATE bucket (Block Public Access on) and an IAM user allowed only
# s3:GetObject / s3:PutObject / s3:ListBucket on it. Case evidence is free-form
# text and can be personal, so the bucket must never be public.
CASES_BUCKET=
CASES_BUCKET_REGION=eu-west-2

# Standard AWS credentials, read by the SDK's default chain. Omit both if the
# app runs somewhere with an instance role attached.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
